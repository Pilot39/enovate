{
  "name": "enovate",
  "version": "0.1.0",
  "description": "Decentralized innovation funding platform on Stellar",
  "private": true,
  "workspaces": [
    "apps/interface",
    "contracts/crowdfund",
    "contracts/registry"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/interface",
    "build": "npm run build -w apps/interface",
    "test": "npm run test -w apps/interface",
    "test:contracts": "npm run test -w contracts/crowdfund",
    "test:all": "npm run test && npm run test:contracts",
    "lint": "npm run lint -w apps/interface",
    "type-check": "npm run type-check -w apps/interface",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=26.12.1",
    "npm": ">=12.0.0"
  }
}
